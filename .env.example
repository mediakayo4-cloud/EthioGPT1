# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# Never expose this key in frontend code or commit real secrets to GitHub.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Override the default Gemini model (defaults to gemini-4-hydrogen)
# GEMINI_MODEL="gemini-4-hydrogen"
# GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
# GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# APP_URL: The URL where this application is hosted (used for links/deployment).
APP_URL="http://localhost:3000"

# PORT: Server listening port (defaults to 3000).
PORT=3000
